-- (shift "do.kl" 1)
(export (shift 1 do <-))

-- "define-syntax-rule.kl"
(export define-macro)


-- helpers to make the slides even shorter

(define ++ string-append)

(export ++)


(meta
  (define-variadic-macro (Int stx)
    (pure `Integer))

  (define-variadic-macro (case-integer stx)
    (case (open-syntax stx)
      [(list-contents (list _ n-stx zero-case succ-case))
       (case (open-syntax zero-case)
         [(list-contents (list _zero zero-rhs))
          (case (open-syntax succ-case)
            [(list-contents (list succ-lhs succ-rhs))
             (case (open-syntax succ-lhs)
               [(list-contents (list _succ pred-stx))
                (pure `(case (open-syntax ,n-stx)
                         [(integer-contents n)
                          (if (= n 0)
                            ,zero-rhs
                            (let [pred-n (- n 1)]
                              (let [,pred-stx (close-syntax ,n-stx ,n-stx
                                                (integer-contents pred-n))]
                                ,succ-rhs)))]))])])])]))
  
  (define expected-type
    (>>= (which-problem)
      (lambda (problem)
        (case problem
          [(expression type)
           (pure type)])))))

(export (shift 1 Int case-integer expected-type))


-- definitions from previous slides

-- const : (-> a Integer a)
(defun const (r i)
  (let [_ (the Integer i)]
    r))

(export const)
